{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/feed/jf2/",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"permalink_structure": "/%postname%/",
				"blogname": "MF2 Feeds Demo",
				"blogdescription": "Microformats2 feeds for WordPress"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "mf2-feed"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/mu-plugins"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/show-admin-notice.php",
			"data": "<?php\nadd_action(\n'admin_notices',\nfunction() {\n$dismissed = get_user_option( 'dismissed_mf2-feed_blueprint_notice', get_current_user_id() );\nif ( $dismissed ) {\nreturn;\n}\necho '<div class=\"notice notice-info is-dismissible\" id=\"mf2-feed-admin-notice\"><p>' . esc_html( 'Welcome to MF2 Feeds! Your site now offers microformats2 JSON feeds at /feed/mf2/ and /feed/jf2/. 👋' ) . '</p></div>';\n}\n);\nadd_action('wp_ajax_dismiss_mf2-feed-admin-notice', function() {\ncheck_ajax_referer('mf2-feed-admin-notice', 'nonce');\n$user_id = get_current_user_id();\nif ( $user_id ) {\nupdate_user_option($user_id, 'dismissed_mf2-feed_blueprint_notice', 1, false);\nwp_send_json_success();\n} else {\nwp_send_json_error('User not found');\n}\n} );\nadd_action('admin_footer', function() {\n?>\n<script type=\"text/javascript\">\njQuery(document).ready( function($) {\nvar ajaxurl = '<?php echo esc_url( admin_url( 'admin-ajax.php' ) ); ?>';\nvar nonce = '<?php echo esc_js( wp_create_nonce( 'mf2-feed-admin-notice' ) ); ?>';\n$( '#mf2-feed-admin-notice' ).on( 'click', '.notice-dismiss', function() {\n$.ajax({\nurl: ajaxurl,\ntype: 'POST',\ndata: {\naction: 'dismiss_mf2-feed-admin-notice',\nnonce: nonce\n}\n});\n});\n});\n</script>\n<?php\n} );"
		},
		{
			"step": "runPHP",
			"code": "<?php\nrequire_once '/wordpress/wp-load.php';\nwp_delete_post( 1, true );\n$posts = array(\n\tarray( 'Hello IndieWeb!', 'Own your content, publish on your own site and syndicate elsewhere.' ),\n\tarray( 'What is microformats2?', 'Microformats2 is a simple way to mark up structured data in HTML, like h-entry for posts and h-card for people.' ),\n\tarray( 'Reading with a Microsub reader', 'Feed readers can consume this site as microformats2 JSON or jf2, no HTML parsing required.' ),\n);\nforeach ( $posts as $i => $post ) {\n\twp_insert_post(\n\t\tarray(\n\t\t\t'post_title'   => $post[0],\n\t\t\t'post_content' => '<!-- wp:paragraph --><p>' . $post[1] . '</p><!-- /wp:paragraph -->',\n\t\t\t'post_status'  => 'publish',\n\t\t\t'post_author'  => 1,\n\t\t\t'post_date'    => gmdate( 'Y-m-d H:i:s', time() - ( 3 - $i ) * DAY_IN_SECONDS ),\n\t\t)\n\t);\n}\nflush_rewrite_rules();\n"
		}
	]
}
